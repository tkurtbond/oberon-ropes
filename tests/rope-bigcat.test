# 1_000_000_000 + 1_000_000_000 = 2_000_000_000, under MAX(LONGINT)
# (2147483647), so this succeeds.  Cheap even at this size: Repeat's
# binary doubling shares subtrees instead of allocating a billion real
# characters.
program RopeTool
arg bigcat
arg 1000000000
arg x
arg 1000000000
arg y
status 0
output
2000000000
