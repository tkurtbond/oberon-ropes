# Each line of data/lines.txt read whole -- including lines of 4096 and
# 4097 characters, either side of Rope.ReadLine/ReadLineRider's
# 4096-character chunk -- and printed as its length, a space, and the
# line.  The last line has no line feed after it.  The same data file
# and expected output as the Ada Ropes port's own rope-lines fixtures.
# Rope.ReadLineRider: FILE opened with Files.Old.
program RopeTool
arg lines
arg tests/data/lines.txt
status 0
output
5 hello
0 
9 two words
4096 
4097 
18 last, unterminated
