# Build the programs with poc, the Peaseblossom Oberon Compiler, as
# installed (poc on PATH, with its runtime library poc-rtl):
#
#   make -f pocGNUmakefile
#
# poc builds in poc-build/, where the sources it needs are symlinked, for
# two reasons. What it writes - each module's .sym (in text), .ll and .o,
# and the programs - lands there and not next to the sources, where it
# would overwrite voc's symbol files (voc then ignores them, "warning 306
# inappropriate symbol file ignored", until they are rebuilt). And poc does
# not see what voc leaves here: it compiles a Module.c beside Module.Mod as
# the module's part in C, which voc's generated Ropes.c is not.
#
# ArgParser is shared with other repos: RopeTool takes it from the poc
# library argparser, in $(POC_OBERON_LIBRARIES)/argparser, where make -f
# pocGNUmakefile install in ~/Repos/Oberon/ArgParser puts it. Only that
# library's directory is on RopeTool's library path, so Ropes itself is
# always compiled from this checkout, never taken from an installed ropes
# library. Files, In, Out, and the Err that ArgParser uses, come from poc's
# runtime library, so no Err.Mod is linked into poc-build/.
#
# make -f pocGNUmakefile install builds Ropes into the poc library ropes,
# once for each size model, in $(POC_OBERON_LIBRARIES)/ropes (poc puts each
# in <triple>/<O2|OC>/ there), where other repos' poc builds find it with
# -library-path.
#
# POC selects another poc, by an absolute path, since it runs in poc-build:
#
#   make -f pocGNUmakefile POC=$HOME/Repos/Oberon/Peaseblossom/build/bin/poc

POC ?= poc

# Each library in its own directory under POC_OBERON_LIBRARIES, so a
# program names only the libraries it uses.
POC_OBERON_LIBRARIES ?= /usr/local/sw/versions/oberon/poc/lib
ARGPARSER_LIB = $(POC_OBERON_LIBRARIES)/argparser

LIBRARY = ropes
LIBDIR = $(POC_OBERON_LIBRARIES)/$(LIBRARY)
MODULES = Ropes
MODELS = O2 OC
TRIPLE = $(shell $(POC) -version | sed -n 's/^target \([^ ]*\).*/\1/p')

# Only RopeTool needs ArgParser, so clean, install and uninstall don't
# check for it. RopeTool is built under the default size model, -O2.
ifneq ($(if $(MAKECMDGOALS),$(filter-out clean install uninstall,$(MAKECMDGOALS)),all),)
$(if $(wildcard $(ARGPARSER_LIB)/*/O2/argparser.library),,$(error the argparser library is not in $(ARGPARSER_LIB); run make -f pocGNUmakefile install in ~/Repos/Oberon/ArgParser))
endif

BUILDDIR = poc-build
PROGRAMS = RopeTool RopeTest

.PHONY: all clean test-poc test-verbose install uninstall

# Keep the symlinks to the sources instead of deleting them as intermediates.
.SECONDARY:

all: $(addprefix $(BUILDDIR)/,$(PROGRAMS))

$(BUILDDIR):
	mkdir -p $@

$(BUILDDIR)/%.Mod: %.Mod | $(BUILDDIR)
	ln -sf $(abspath $<) $@

# RopeTool imports ArgParser (from its library) and Ropes, RopeTest Ropes.
$(BUILDDIR)/RopeTool: LIBPATH = -library-path $(ARGPARSER_LIB)
$(BUILDDIR)/RopeTool: $(wildcard $(ARGPARSER_LIB)/*/O2/argparser.library)
$(BUILDDIR)/RopeTool $(BUILDDIR)/RopeTest: $(BUILDDIR)/Ropes.Mod

# poc compiles every module of a program from its source on every build,
# except those a library on the library path has.
$(BUILDDIR)/%: $(BUILDDIR)/%.Mod
	cd $(BUILDDIR) && $(POC) $(LIBPATH) -o $* $*.Mod

# Run the fixtures in tests/ against the poc-built programs and report how
# many passed and failed; test-verbose announces each test as it goes.
test-poc: all
	BINDIR=$(BUILDDIR) ./tests/run-tests.sh

test-verbose: all
	BINDIR=$(BUILDDIR) ./tests/run-tests.sh -v

# Install only a module that compiles: RopeTest builds Ropes without
# ArgParser.
# Built in poc-build/lib/, away from voc's Ropes.c, then copied with poc
# -install-library, which copies only what a program needs: the archive,
# the shared object, the manifest, and each module's .sym and .owner (not
# the .o and .ll that -library also writes). A library records the poc
# that built it, and another poc refuses it: install again after
# upgrading poc.
install: $(BUILDDIR)/RopeTest
	cd $(BUILDDIR) && for m in $(MODELS); do \
	  $(POC) -$$m -output-dir lib -library $(LIBRARY) $(MODULES:%=%.Mod) || exit 1; \
	done
	install -d $(LIBDIR)
	for m in $(MODELS); do \
	  $(POC) -$$m -library-path $(BUILDDIR)/lib -output-dir $(LIBDIR) -install-library $(LIBRARY) || exit 1; \
	done

# Remove what make install wrote, and only that.
uninstall:
	for m in $(MODELS); do d=$(LIBDIR)/$(TRIPLE)/$$m; \
	  rm -f $$d/lib$(LIBRARY).a $$d/lib$(LIBRARY).so $$d/$(LIBRARY).library \
	    $(foreach x,$(MODULES),$$d/$(x).sym $$d/$(x).owner); \
	  rmdir $$d 2>/dev/null; true; \
	done

clean:
	-rm -rfv $(BUILDDIR)
